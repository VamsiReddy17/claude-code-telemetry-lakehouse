{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "version": "1.0.0",
  "description": "Enterprise Managed Settings for 2,500 Claude Code Active Users",
  "env": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://claude-telemetry-collector.enterprise.internal:4317",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "OTEL_SERVICE_NAME": "claude-code-cli",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_ASSISTANT_RESPONSES": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "1",
    "OTEL_LOG_RAW_API_BODIES": "0",
    "CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH": "65536",
    "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment=production,org.company=EnterpriseCorp,org.deployment_tier=2500_users"
  },
  "telemetry": {
    "enabled": true,
    "allowUnredactedPrompts": true,
    "allowToolOutputs": true,
    "batchIntervalMs": 5000,
    "maxQueueSize": 2048,
    "compression": "gzip"
  },
  "security": {
    "requireManagedIdentity": true,
    "blockUnauthorizedExporters": true,
    "auditPromptContent": true,
    "secretMaskingClientSide": true
  },
  "compliance": {
    "dataRetentionNoticeAcknowledged": true,
    "enterprisePolicyVersion": "2026.1"
  }
}
