# -----------------------------------------------------------------------------
# Copy to .env and fill values. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- OpenTelemetry Collector ---
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# --- ADLS Gen2 / Azure Storage ---
# Production: real storage account. Local: Azurite via docker compose.
AZURE_STORAGE_ACCOUNT=stgclaudetelemdev
AZURE_STORAGE_CONTAINER=claude-telemetry
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_AUTH_MODE=connection_string
# Production preferred:
# AZURE_STORAGE_AUTH_MODE=managed_identity
# AZURE_CLIENT_ID=

# Path prefix inside container
ADLS_BRONZE_PREFIX=bronze/otel/logs

# --- Databricks ---
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=claude_telemetry
DATABRICKS_SCHEMA_BRONZE=bronze
DATABRICKS_SCHEMA_SILVER=silver
DATABRICKS_SCHEMA_GOLD=gold
DATABRICKS_EXTERNAL_LOCATION=abfss://claude-telemetry@stgclaudetelemdev.dfs.core.windows.net/bronze/otel/logs

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=xy12345.east-us-2.azure
SNOWFLAKE_USER=CLAUDE_TELEM_SVC
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=CLAUDE_TELEM_ROLE
SNOWFLAKE_WAREHOUSE=CLAUDE_TELEM_WH
SNOWFLAKE_DATABASE=CLAUDE_TELEMETRY
SNOWFLAKE_SCHEMA_BRONZE=BRONZE
SNOWFLAKE_SCHEMA_SILVER=SILVER
SNOWFLAKE_SCHEMA_GOLD=GOLD
# Azure stage credentials (prefer storage integration in prod)
SNOWFLAKE_AZURE_SAS_TOKEN=

# --- Pipeline ---
ORG_ID=acme-corp
ENVIRONMENT=dev
CONTENT_MAX_LENGTH=61440
